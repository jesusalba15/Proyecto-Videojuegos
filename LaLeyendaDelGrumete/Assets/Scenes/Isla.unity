  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc755be2dd7a606468f27031c4e1cce9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Encargo
  nombre: Pico
  grupo: herramientas_pico
  cantidad: 3
  radio: 2.5
  recompensa: {fileID: 1615948216}
  requisito: {fileID: 0}
  fraseInicio: "\xBFUn grumete? Sin mis herramientas no arreglo ni una tabla. Los carro\xF1eros me robaron el martillo, el serrucho y el cepillo. Uno qued\xF3 en el casco hundido: de noche, con la marea baja, se puede llegar."
  fraseFalta: "Todav\xEDa me faltan {n}. Busca bien, grumete."
  fraseFin: "\xA1Mis herramientas! Est\xE1 bien, contigo voy. Le pongo una vela nueva a ese cascar\xF3n y vas a volar."
  fraseDespues: "Cuando necesites el taller, inv\xF3came con G y te cobran menos."
